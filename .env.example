# Server-only environment variables for the Vercel API.
# Set real values in Vercel Project Settings; never commit populated values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
OPENAI_API_KEY= # Required for AI endpoints only; configure in Vercel, never in frontend files.
OPENAI_MODEL= # Required; choose a model enabled for this OpenAI API account.
