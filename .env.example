# Server-only environment variables for the Vercel API.
# Set the real values in Vercel Project Settings; never commit populated values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Optional AI assistants: configure in Vercel only, never in browser files.
OPENAI_API_KEY=replace_me
# Set to a model enabled for your OpenAI API project; no default is assumed.
OPENAI_MODEL=replace_with_enabled_model
