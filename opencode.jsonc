{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "paperwise-guardian",
  "share": "disabled",
  "mcp": {
    "servers": {
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "protocol": "auto"
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com",
        "protocol": "auto"
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=sweoiivfmgvekuhtcuiz&read_only=true&features=database,debugging,docs,development,functions",
        "protocol": "auto"
      }
    }
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "cloudflare_*", "resource": "*", "effect": "ask" },
    { "action": "vercel_*", "resource": "*", "effect": "ask" },
    { "action": "supabase_*", "resource": "*", "effect": "ask" }
  ]
}
